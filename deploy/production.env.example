# Modele a remplir dans /etc/ufhob/production.env, root:ufhob 0640.
# Ne pas copier le .env local ni publier les valeurs renseignees.
DJANGO_SETTINGS_MODULE=config.settings_production
UFHOB_ENVIRONMENT=production
DEBUG=False
SECRET_KEY=generate-a-new-secret-with-at-least-50-characters
CARD_SIGNING_KEY=generate-another-independent-secret-with-at-least-50-characters
BASE_URL=https://ufhob-mali.ml
ALLOWED_HOSTS=ufhob-mali.ml
CSRF_TRUSTED_ORIGINS=https://ufhob-mali.ml
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
USE_X_FORWARDED_HOST=False
ENABLE_BROWSER_RELOAD=False
SYSTEM_SESSION_MANUAL_TEST_MODE=False
ONLINE_CLASSROOM_TIME_BYPASS=False

DATABASE_URL=postgresql://ufhob_app:replace-me@127.0.0.1:5432/ufhob_db
# False only for a PostgreSQL instance on the same machine/private trusted link.
# Use True for a remote provider requiring SSL, following its connection policy.
DB_SSL_REQUIRE=False
DB_CONN_MAX_AGE=0
ENABLE_WEBSOCKETS=True
REDIS_URL=redis://127.0.0.1:6379/2
CACHE_REDIS_URL=redis://127.0.0.1:6379/2
# Prefixes imposes par settings_production : ufhob:production et ufhob:production:channels.
# DB 2 : index a confirmer libre/autorise ; ne jamais vider Redis.

EMAIL_BACKEND=core.mail_backends.StableSMTPEmailBackend
EMAIL_HOST=replace-with-smtp-host
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=replace-with-verified-sender@example.invalid
EMAIL_FROM_NAME=UFHOB
COMMUNICATION_EMAIL_PROVIDER=brevo
COMMUNICATION_EMAIL_PROVIDER_MODE=smtp
NOTIFIER_EMAIL_PROVIDER=brevo
NOTIFIER_EMAIL_PROVIDER_MODE=smtp
FFMPEG_PATH=ffmpeg
PUBLIC_CONTACT_PHONES_CONFIRMED=False

# Classes virtuelles : renseigner uniquement les valeurs du compte UFHOB cible.
ONLINE_CLASSROOM_PROVIDER=bigbluebutton
BBB_API_URL=
BBB_SECRET=
BBB_API_TIMEOUT=10
BBB_MEETING_ID_PREFIX=ufhob
ONLINE_CLASSROOM_RECORDING_ENABLED=False

# Stockages prives optionnels (laisser tous les identifiants vides si local).
B2_ENDPOINT_URL=
B2_BUCKET_NAME=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_REGION=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
B2_RECORDINGS_BUCKET=
B2_RECORDINGS_ENDPOINT=
B2_RECORDINGS_REGION=
B2_RECORDINGS_ACCESS_KEY_ID=
B2_RECORDINGS_SECRET_ACCESS_KEY=

META_PIXEL_ID=
