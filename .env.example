# Exemple LOCAL sans secret reel. Production : deploy/production.env.example.
# Le profil se selectionne dans le shell avant manage.py, pas uniquement dans .env.
# Domaine et sécurité
SECRET_KEY=generate-a-unique-random-secret
CARD_SIGNING_KEY=generate-a-distinct-random-secret
DEBUG=True
BASE_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
USE_X_FORWARDED_HOST=False
ENABLE_BROWSER_RELOAD=True

# PostgreSQL
DATABASE_URL=postgresql://ufhob_app:replace-me@127.0.0.1:5432/ufhob_db
DB_SSL_REQUIRE=False

# ASGI, WebSockets et cache
ENABLE_WEBSOCKETS=True
REDIS_URL=
# Production: Redis prive obligatoire; voir deploy/production.env.example.
CHANNEL_REDIS_PREFIX=ufhob:local:channels

# Classes virtuelles BigBlueButton (secret serveur uniquement)
ONLINE_CLASSROOM_PROVIDER=bigbluebutton
BBB_API_URL=https://bbb.example.com/bigbluebutton/api
BBB_SECRET=replace-me
BBB_API_TIMEOUT=10
BBB_MEETING_ID_PREFIX=ufhob
ONLINE_CLASSROOM_TIME_BYPASS=false
ONLINE_CLASSROOM_END_GRACE_MINUTES=10
ONLINE_CLASSROOM_RECORDING_ENABLED=false
COURSE_CHECKIN_GRACE_MINUTES=10
COURSE_END_WARNING_MINUTES=15

# Backblaze B2 privé — enregistrements BBB (ne jamais placer de vraies clés ici)
B2_RECORDINGS_BUCKET=
B2_RECORDINGS_ENDPOINT=
B2_RECORDINGS_REGION=eu-central-003
B2_RECORDINGS_ACCESS_KEY_ID=
B2_RECORDINGS_SECRET_ACCESS_KEY=
B2_RECORDINGS_SIGNED_URL_SECONDS=300

# SMTP / Brevo
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_FROM_NAME=UFHOB
COMMUNICATION_EMAIL_PROVIDER=brevo
COMMUNICATION_EMAIL_PROVIDER_MODE=smtp
NOTIFIER_EMAIL_PROVIDER=brevo
NOTIFIER_EMAIL_PROVIDER_MODE=smtp

# Stockage et outils système
FFMPEG_PATH=ffmpeg

# Enable only after Institution.phone has been confirmed as current public contact.
PUBLIC_CONTACT_PHONES_CONFIRMED=false
